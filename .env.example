# AgentProbe environment. Copy to `.env` and fill in what your run needs.
# `.env` is gitignored — real credentials live only in env vars, never in the
# repo. Commented values show the default the code falls back to.

# --- Evaluation-time LLM traffic --------------------------------------------

# Required for persona/judge traffic during evaluation runs.
OPEN_ROUTER_API_KEY=

# Optional persona model override.
# AGENTPROBE_PERSONA_MODEL=

# --- Target endpoints --------------------------------------------------------

# OpenClaw gateway (used by data/openclaw-endpoints.yaml).
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# AutoGPT backend the benchmarks run against.
# AUTOGPT_BACKEND_URL=http://localhost:8006

# --- AutoGPT platform auth ---------------------------------------------------
# Which strategy resolveAuth uses. The mode is a property of the target
# environment, not of AgentProbe — see docs/playbooks/autogpt-auth.md.
#   supabase     (default) forge an HS256 token with the shared GoTrue secret
#   better-auth  sign a real account in and mint an ES256 token via JWKS
# AUTOGPT_AUTH_MODE=supabase

# supabase mode: the platform's shared JWT_VERIFY_KEY.
# AUTOGPT_JWT_SECRET=

# better-auth mode: Better Auth is mounted on the platform *frontend*, and the
# benchmark account must already exist (no random-email fallback).
# AUTOGPT_FRONTEND_URL=http://localhost:3000
# AUTOGPT_EMAIL=
# AUTOGPT_PASSWORD=

# Opt-in: provision the benchmark account on first use where signup is open.
# Off by default so a typo'd email cannot mint a new real account per run.
# AUTOGPT_ALLOW_SIGNUP=false

# Rate-limit tier grant (admin-only endpoint). Preferred: mark the benchmark
# account admin so its own token authorizes the grant — then neither of these
# is needed. AUTOGPT_USER_ID overrides the token's `sub` as the grant target.
# AUTOGPT_ADMIN_TOKEN=
# AUTOGPT_USER_ID=
